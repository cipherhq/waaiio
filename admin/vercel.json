{
  "git": {
    "deploymentEnabled": {
      "codex/merchant-tax-phase-a": false,
      "codex/directory-short-links": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
