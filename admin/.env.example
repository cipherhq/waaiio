# Explicit logical Waaiio environment. Never infer this from hostname or Vercel target alone.
# Allowed: production | staging | development
VITE_WAAIIO_ENVIRONMENT=development

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=https://www.waaiio.com

# Optional browser-restricted Google Places key. Missing/unavailable Google keeps manual entry.
# VITE_GOOGLE_PLACES_API_KEY and existing NEXT_PUBLIC Google key names are also supported.
VITE_GOOGLE_MAPS_API_KEY=
