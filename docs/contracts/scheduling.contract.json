{
  "_schema": "waaiio-capability-contract-v1",
  "id": "scheduling",
  "subscriptionTier": "free",
  "riskTier": "tier-1",
  "flowType": "scheduling",
  "flowFile": "lib/bot/flows/scheduling.flow.ts",

  "stateOwned": {
    "write": ["bookings", "bot_sessions.session_data"],
    "read": ["services", "businesses", "customer_profiles", "events", "event_ticket_types", "payout_accounts", "business_payment_credentials"]
  },

  "authorities": {
    "initialCreation": {
      "authority": "scheduling.flow.ts create_booking step",
      "notes": "Free/no-deposit: created directly as status='confirmed'. Paid: created as status='pending'. This is a legitimate confirmed-write outside processSuccessfulPayment."
    },
    "paidConfirmation": {
      "authority": "processSuccessfulPayment (via Payment Authority)",
      "file": "lib/payments/process-success.ts",
      "notes": "pending→confirmed with CAS guard .in('status', ['pending']). Only authority for paid booking state transition."
    },
    "cancellation": {
      "authority": "CAS-guarded cancel in bot flow + cancel_stale_order_atomic cron",
      "notes": "Cancel only while status IN ('pending'). Zero-row re-read + already_confirmed recovery."
    },
    "customerSpend": {
      "authority": "apply_payment_spend_once (migration 334)",
      "notes": "Durable per-payment marker. Called from processSuccessfulPayment."
    },
    "postCompletion": {
      "authority": "handlePostCompletion via sendProactiveConfirmation (Stage 3)",
      "file": "lib/bot/flows/shared/post-completion.ts",
      "notes": "Receipts, loyalty, automation, referral. skipCustomerSpend=true for paid bookings."
    },
    "providerVerification": {
      "authority": "verifyAndReconcilePayment → reconcilePayment → authorizeAndFinalize",
      "file": "lib/payments/bot-recovery.ts",
      "notes": "I've Paid path converges through canonical Payment Authority (PR #160)."
    }
  },

  "forbiddenWrites": [
    "customer_profiles.total_spent — use apply_payment_spend_once",
    "bookings.status paid-confirmation outside processSuccessfulPayment",
    "bookings.deposit_status outside processSuccessfulPayment"
  ],

  "sessionKeys": {
    "keys": {
      "booking_id": { "owner": "scheduling", "producers": ["create_booking"], "consumers": ["payment", "cancel", "post-completion"], "classification": "domain" },
      "reference_code": { "owner": "scheduling", "producers": ["create_booking"], "consumers": ["payment", "cancel", "UX messages"], "classification": "domain" },
      "service_id": { "owner": "scheduling", "producers": ["select_service"], "consumers": ["create_booking", "recurring-manage"], "classification": "domain" },
      "service_name": { "owner": "scheduling", "producers": ["select_service"], "consumers": ["UX messages", "post-completion"], "classification": "domain" },
      "date": { "owner": "scheduling", "producers": ["select_date"], "consumers": ["create_booking", "executor entity extraction"], "classification": "domain" },
      "time": { "owner": "scheduling", "producers": ["select_time"], "consumers": ["create_booking", "executor entity extraction"], "classification": "domain" },
      "party_size": { "owner": "scheduling", "producers": ["select_quantity"], "consumers": ["create_booking", "executor entity extraction"], "classification": "domain" },
      "payment_reference": { "owner": "shared-payment", "producers": ["create_booking/initializePayment"], "consumers": ["I've Paid", "retry_payment", "bot-recovery"], "classification": "shared", "stalePostback": "Recovery-gated: retry_payment runs verifyAndReconcilePayment before acting" },
      "_payment_retry_blocked": { "owner": "shared-payment", "producers": ["I've Paid validate", "retry_payment validate"], "consumers": ["payment prompt", "retry_payment guard"], "classification": "shared", "persistence": "persistSessionDataOnFailure", "cleanup": "Cleared on definitive not_paid" },
      "_action": { "owner": "shared-flow", "producers": ["validate()"], "consumers": ["next()"], "classification": "shared", "values": ["cancel", "payment_confirmed", "already_confirmed", "payment_processing", "transfer_proof_sent", "retry_payment"] },
      "_retry_payment": { "owner": "shared-payment", "producers": ["retry_payment validate"], "consumers": ["next()"], "classification": "shared" },
      "active_capability": { "owner": "executor", "producers": ["capability-selection"], "consumers": ["executor CAS-007 auth", "flow step UX"], "classification": "shared" },
      "bank_transfer_reference": { "owner": "shared-payment", "producers": ["create_booking bank-transfer"], "consumers": ["transfer proof handling", "cancel guard", "executor"], "classification": "shared" }
    },
    "persistence": "Primarily CAS via update_session_cas RPC. Direct .update() for payment step session advance (bypasses CAS version — known debt).",
    "cleanup": "Session deactivated by Stage 3 sendProactiveConfirmation or executor terminal step."
  },

  "dashboardSurfaces": ["/dashboard/reservations", "/dashboard/calendar"],
  "apiRoutes": ["/api/bookings/*", "/api/services/*"],
  "webhookDependencies": ["payment webhooks (all 5 gateways via reconcilePayment)"],

  "supportedCombinations": [
    "scheduling alone (free booking)",
    "scheduling + payment (deposit/full payment)",
    "scheduling + ticketing (event bookings)",
    "scheduling + loyalty (post-completion)",
    "scheduling + recurring (subscription setup after payment)"
  ],

  "requiredTestsOnChange": [
    "lib/bot/flows/__tests__/payment-convergence-scheduling-ticketing.test.ts",
    "lib/bot/flows/__tests__/recovery-gated-retry.test.ts",
    "lib/__tests__/payment-vs-cancel-concurrency.test.ts",
    "lib/__tests__/spend-marker-application-boundary.test.ts"
  ],

  "knownDebt": [
    "Legacy verifyPayment() gateway side effects (paystack.ts:204-221 etc.) mutate booking state outside Payment Authority",
    "handlePostCompletion loyalty/referral side effects are non-idempotent (no per-payment marker)"
  ]
}
